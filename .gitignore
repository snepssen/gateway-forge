.build/
.dd/
build/
*.app/
*.log
.DS_Store
renders/
segments-rendered/
cache/
voices/_audition/
/memory/assembly-queue.json
# 7 MB of reference tensors, regenerated by tools/qwen3-groundtruth.py
library/reference/qwen3-groundtruth/
/memory/deleted/
# Raw source recordings. The built reference clips live in voices/<name>/ and
# the four retained runtime assets are tracked in library/media/; this is the
# material they were cut from, kept beside the project rather than in it.
/media/
# Generated listening and composition state, tied one-to-one to render
# directories that are themselves ignored. Tracking a reviewed recipe for a
# session whose audio git never sees would be a record of nothing.
/memory/sessions/
# The practice ledger: one listener's own history with their own copy of the
# application. It belongs on their machine, not in the source tree, and a
# committed one would hand every checkout somebody else's hours.
/memory/activity.json
voices/*/preview.wav
voices/*/preview.engine
# Fine-tuned models under voices/ are private local installations. Public
# models are declared explicitly under Sources/GatewayTTS/Resources instead.
voices/*/*.onnx
voices/*/*.onnx.json
# Written visits, and the sync ledger that carries them between devices. The
# same rule as the practice ledger above: one listener's own account of what
# they found, which belongs on their machine rather than in the source tree.
# The companion writes entries here, so this is the path a phone's journal
# arrives on -- committing it would hand every checkout somebody's night.
/focus/*/entries/
/memory/sync-inbox.json
