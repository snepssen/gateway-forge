# Parity fixtures contain byte-level digests of authored source. A Windows
# checkout must read the same bytes Swift measured on macOS.
cross-platform/** text eol=lf
# ...but the vendored phonemizer is a WebAssembly binary, and the rule above
# would "normalise" its line endings into corruption. Git said so as a warning
# on the very first `git add`; it is an error waiting to happen on a Windows
# checkout, where the damage would show up as a phonemizer that will not load.
cross-platform/vendor/espeakng/*.wasm binary

# Same problem, different binaries: the app icons electron-builder reads for
# the win/linux/mac targets. These sat uncommitted on disk since the icon was
# first added -- discovered via a CRLF warning while fixing a similar issue
# in the development tree.
cross-platform/build/icon.ico binary
cross-platform/build/icon.icns binary
cross-platform/build/icon.png binary
library/**/*.gws text eol=lf
library/reference/**/*.json text eol=lf
focus/**/*.gws text eol=lf
fixtures/** text eol=lf

# `memory/audio.json` is written by *both* builds, and `audio-parity` compares
# the bytes the TypeScript encoder produces against the ones Swift's
# `JSONEncoder` left there. A CRLF checkout fails that comparison, and worse,
# the first slider moved on Windows would rewrite the whole file back to LF.
memory/** text eol=lf
